# IP MANAGEMENT
# =============================
def load_allowed_ips():
    data = read_json(ALLOWED_IPS_FILE, {})
    return data if isinstance(data, dict) else {}


def save_allowed_ips(data) -> None:
    write_json(ALLOWED_IPS_FILE, data)


def cleanup_expired_ips():
    ips = load_allowed_ips()
    now = time.time()

    active = {
        ip: meta
        for ip, meta in ips.items()
        if float(meta.get("expires_at", 0)) > now
    }

    if len(active) != len(ips):
        save_allowed_ips(active)

    return active


def add_ip(ip: str, minutes: int, telegram_id: int | None = None) -> None:
    ips = load_allowed_ips()
    now = time.time()

    meta = {
        "created_at": now,
        "expires_at": now + minutes * 60,
        "minutes": minutes,
    }

    if telegram_id:
        meta["telegram_id"] = int(telegram_id)

    ips[ip] = meta
    save_allowed_ips(ips)


def remove_ip(ip: str) -> bool:
    ips = load_allowed_ips()

    if ip not in ips:
        return False

    del ips[ip]
    save_allowed_ips(ips)
    return True


# =============================
# FREE MODE
# =============================
def free_mode_active() -> bool:
    data = read_json(FREE_PROXY_FILE, {"enabled": False, "expires_at": 0})

    if data.get("enabled") and time.time() < float(data.get("expires_at", 0)):
        return True

    if FREE_MODE_FILE.exists():
        return True

    return False


def enable_free_mode(minutes: int | None = None) -> None:
    now = time.time()

    if minutes is None:
        expires_at = now + 365 * 24 * 60 * 60
        minutes_value = 0
    else:
        expires_at = now + minutes * 60
        minutes_value = minutes

    FREE_MODE_FILE.write_text("on", encoding="utf-8")

    write_json(
        FREE_PROXY_FILE,
        {
            "enabled": True,
            "created_at": now,
            "expires_at": expires_at,
            "minutes": minutes_value,
        },
    )


def disable_free_mode() -> None:
    try:
        if FREE_MODE_FILE.exists():
            FREE_MODE_FILE.unlink()
    except Exception:
        pass

    write_json(
        FREE_PROXY_FILE,
        {
            "enabled": False,
            "created_at": 0,
            "expires_at": 0,
            "minutes": 0,
        },
    )


def free_mode_status_text() -> str:
    data = read_json(FREE_PROXY_FILE, {"enabled": False, "expires_at": 0})

    if free_mode_active():
        expires_at = float(data.get("expires_at", 0))
        if expires_at > time.time():
            return f"🟢 ON — {human_time_left(expires_at)} left"
        return "🟢 ON"

    return "🔴 OFF"


# =============================
# PROXY PROCESS
# =============================
def proxy_running() -> bool:
    try:
        result = subprocess.run(
            "pgrep -f mitmdump",
            shell=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        return bool(result.stdout.strip())
    except Exception:
        return False


def start_proxy_process() -> str:
    if proxy_running():
        return "▶️ Proxy already running."

    command = os.getenv("PROXY_COMMAND", DEFAULT_PROXY_COMMAND)

    try:
        log_file = open("/root/nohup_proxy.out", "a", encoding="utf-8")

        process = subprocess.Popen(
            command,
            shell=True,
            stdout=log_file,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )

        PROXY_PID_FILE.write_text(str(process.pid), encoding="utf-8")

        return f"✅ Proxy started.\nPID: <code>{process.pid}</code>"

    except Exception as e:
        return f"❌ Failed to start proxy:\n<code>{e}</code>"


def stop_proxy_process() -> str:
    try:
        subprocess.run("pkill -f mitmdump", shell=True)
    except Exception:
        pass

    try:
        if PROXY_PID_FILE.exists():
            PROXY_PID_FILE.unlink()
    except Exception:
        pass

    time.sleep(1)

    if proxy_running():
        try:
            subprocess.run("pkill -9 -f mitmdump", shell=True)
        except Exception:
            pass

    if proxy_running():
        return "⚠️ Tried to stop proxy, but it still looks running."

    return "✅ Proxy stopped."


