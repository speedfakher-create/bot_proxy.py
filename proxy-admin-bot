# =============================
# JSON HELPERS
# =============================
def read_json(path: Path, default):
    try:
        if not path.exists():
            return default
        with path.open("r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def write_json(path: Path, data):
    with path.open("w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, sort_keys=True)


# =============================
# ACCESS / IP HELPERS
# =============================
def is_admin(update: Update) -> bool:
    user = update.effective_user
    return bool(user and user.id == ADMIN_ID)


def validate_ip(value: str) -> str:
    return str(ip_address(value.strip()))


def parse_ip_line(line: str):
    line = line.strip()
    if not line:
        raise ValueError("empty line")

    if ":" in line and line.count(":") == 1:
        raw_ip, raw_minutes = line.split(":", 1)
        minutes = int(raw_minutes.strip() or DEFAULT_MINUTES)
    else:
        raw_ip = line
        minutes = DEFAULT_MINUTES

    if minutes <= 0:
        raise ValueError("minutes must be greater than 0")

    return validate_ip(raw_ip), minutes


def load_allowed_ips():
    data = read_json(ALLOWED_IPS_FILE, {})
    return data if isinstance(data, dict) else {}


def save_allowed_ips(data):
    write_json(ALLOWED_IPS_FILE, data)


def cleanup_expired_ips():
    ips = load_allowed_ips()
    now = time.time()

    active = {
        ip: meta
        for ip, meta in ips.items()
        if float(meta.get("expires_at", 0)) > now
    }

    if len(active) != len(ips):
        save_allowed_ips(active)

    return active


def add_ip(ip: str, minutes: int):
    ips = load_allowed_ips()
    now = time.time()

    ips[ip] = {
        "created_at": now,
        "expires_at": now + minutes * 60,
        "minutes": minutes,
    }

    save_allowed_ips(ips)


def remove_ip(ip: str) -> bool:
    ips = load_allowed_ips()
    if ip not in ips:
        return False

    del ips[ip]
    save_allowed_ips(ips)
    return True


def human_time_left(expires_at: float) -> str:
    seconds = max(0, int(expires_at - time.time()))
    minutes, sec = divmod(seconds, 60)
    hours, minutes = divmod(minutes, 60)

    if hours:
        return f"{hours}h {minutes}m"
    if minutes:
        return f"{minutes}m {sec}s"
    return f"{sec}s"


# =============================
# FREE MODE
# =============================
def free_mode_active() -> bool:
    data = read_json(FREE_PROXY_FILE, {"enabled": False, "expires_at": 0})

    if data.get("enabled") and time.time() < float(data.get("expires_at", 0)):
        return True

    if FREE_MODE_FILE.exists():
        return True

    return False


def enable_free_mode(minutes: int | None = None):
    now = time.time()

    if minutes is None:
        expires_at = now + 365 * 24 * 60 * 60
        minutes_value = 0
    else:
        expires_at = now + minutes * 60
        minutes_value = minutes

    FREE_MODE_FILE.write_text("on", encoding="utf-8")

    write_json(
        FREE_PROXY_FILE,
        {
            "enabled": True,
            "created_at": now,
            "expires_at": expires_at,
            "minutes": minutes_value,
        },
    )


def disable_free_mode():
    if FREE_MODE_FILE.exists():
        FREE_MODE_FILE.unlink()

    write_json(
        FREE_PROXY_FILE,
        {
            "enabled": False,
            "created_at": 0,
            "expires_at": 0,
            "minutes": 0,
        },
    )


def free_mode_status_text() -> str:
    data = read_json(FREE_PROXY_FILE, {"enabled": False, "expires_at": 0})

    if free_mode_active():
        expires_at = float(data.get("expires_at", 0))
        if expires_at > time.time():
            return f"🟢 ON — {human_time_left(expires_at)} left"
        return "🟢 ON"

    return "🔴 OFF"


