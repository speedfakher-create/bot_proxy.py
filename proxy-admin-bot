# =============================
# FILE HELPERS
# =============================
def ensure_data_dir() -> None:
    DATA_DIR.mkdir(parents=True, exist_ok=True)


def read_json(path: Path, default):
    ensure_data_dir()
    try:
        if not path.exists():
            return default
        with path.open("r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def write_json(path: Path, data) -> None:
    ensure_data_dir()
    with path.open("w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, sort_keys=True)


# =============================
# ADMIN / BAN HELPERS
# =============================
def load_admins() -> set[int]:
    data = read_json(ADMINS_FILE, [])
    admins = set()

    if isinstance(data, list):
        for item in data:
            try:
                admins.add(int(item))
            except Exception:
                pass

    admins.add(MASTER_ADMIN_ID)
    return admins


def save_admins(admins: set[int]) -> None:
    admins.add(MASTER_ADMIN_ID)
    write_json(ADMINS_FILE, sorted(list(admins)))


def add_admin_id(user_id: int) -> None:
    admins = load_admins()
    admins.add(int(user_id))
    save_admins(admins)


def delete_admin_id(user_id: int) -> bool:
    user_id = int(user_id)
    if user_id == MASTER_ADMIN_ID:
        return False

    admins = load_admins()
    if user_id not in admins:
        return False

    admins.remove(user_id)
    save_admins(admins)
    return True


def load_banned_users() -> set[int]:
    data = read_json(BANNED_USERS_FILE, [])
    banned = set()

    if isinstance(data, list):
        for item in data:
            try:
                banned.add(int(item))
            except Exception:
                pass

    return banned


def save_banned_users(banned: set[int]) -> None:
    write_json(BANNED_USERS_FILE, sorted(list(banned)))


def ban_user_id(user_id: int) -> None:
    banned = load_banned_users()
    banned.add(int(user_id))
    save_banned_users(banned)


def unban_user_id(user_id: int) -> bool:
    banned = load_banned_users()
    user_id = int(user_id)

    if user_id not in banned:
        return False

    banned.remove(user_id)
    save_banned_users(banned)
    return True


def is_banned(update: Update) -> bool:
    user = update.effective_user
    if not user:
        return False
    return int(user.id) in load_banned_users()


def is_admin(update: Update) -> bool:
    user = update.effective_user
    if not user:
        return False
    return int(user.id) in load_admins()


