async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    if is_banned(update):
        return

    text = (update.message.text or "").strip()
    state = context.user_data.get("state", STATE_NONE)

    if not is_admin(update):
        if state == STATE_USER_SEND_IP:
            try:
                ip = validate_ip(text)
                add_ip(ip, USER_FREE_MINUTES, telegram_id=update.effective_user.id)
                context.user_data["state"] = STATE_NONE

                await update.message.reply_html(
                    proxy_steps(ip),
                    reply_markup=InlineKeyboardMarkup(
                        [[InlineKeyboardButton("📢 Join Channel", url=CHANNEL_LINK)]]
                    ),
                )
            except Exception:
                await update.message.reply_html(
                    "❌ Invalid IP address.\n\nSend only your IP like:\n<code>105.158.96.43</code>"
                )
            return

        context.user_data["state"] = STATE_USER_SEND_IP
        await update.message.reply_html(user_start_text(update.effective_user.id))
        return

    if state == STATE_ADD_ADMIN:
        try:
            user_id = int(text)
            add_admin_id(user_id)
            context.user_data["state"] = STATE_NONE
            await update.message.reply_html(
                f"✅ Added admin: <code>{user_id}</code>",
                reply_markup=main_menu(),
            )
        except Exception as e:
            await update.message.reply_html(f"❌ Invalid admin ID: <code>{e}</code>")
        return

    if state == STATE_DELETE_ADMIN:
        try:
            user_id = int(text)
            context.user_data["state"] = STATE_NONE
            if delete_admin_id(user_id):
                await update.message.reply_html(
                    f"✅ Deleted admin: <code>{user_id}</code>",
                    reply_markup=main_menu(),
                )
            else:
                await update.message.reply_html(
                    "⚠️ Admin not found, or you tried to delete master admin.",
                    reply_markup=main_menu(),
                )
        except Exception as e:
            await update.message.reply_html(f"❌ Invalid admin ID: <code>{e}</code>")
        return

    if state == STATE_BAN_USER:
        try:
            user_id = int(text)
            ban_user_id(user_id)
            context.user_data["state"] = STATE_NONE
            await update.message.reply_html(
                f"🚫 Banned user: <code>{user_id}</code>",
                reply_markup=main_menu(),
            )
        except Exception as e:
            await update.message.reply_html(f"❌ Invalid user ID: <code>{e}</code>")
        return

    if state == STATE_UNBAN_USER:
        try:
            user_id = int(text)
            context.user_data["state"] = STATE_NONE
            if unban_user_id(user_id):
                await update.message.reply_html(
                    f"✅ Unbanned user: <code>{user_id}</code>",
                    reply_markup=main_menu(),
                )
            else:
                await update.message.reply_html(
                    f"⚠️ User ID not found in banned list.",
                    reply_markup=main_menu(),
                )
        except Exception as e:
            await update.message.reply_html(f"❌ Invalid user ID: <code>{e}</code>")
        return

    if state == STATE_FREE_CUSTOM:
        try:
            minutes = int(text)
            if minutes <= 0:
                raise ValueError("minutes must be greater than 0")

            enable_free_mode(minutes)
            context.user_data["state"] = STATE_NONE

            await update.message.reply_html(
                f"✅ Free Mode enabled for <b>{minutes}</b> minutes.",
                reply_markup=main_menu(),
            )
        except Exception as e:
            await update.message.reply_html(f"❌ Invalid time: <code>{e}</code>")
        return

    if state == STATE_ADD_IP:
        try:
            ip, minutes = parse_ip_line(text)
            add_ip(ip, minutes)
            context.user_data["state"] = STATE_NONE

            await update.message.reply_html(
                f"✅ Added <code>{ip}</code> for <b>{minutes}</b> minutes.",
                reply_markup=main_menu(),
            )
        except Exception as e:
            await update.message.reply_html(f"❌ Error: <code>{e}</code>")
        return

    if state == STATE_BULK_IMPORT:
        added = 0
        errors = 0

        for line in text.splitlines():
            if not line.strip():
                continue

            try:
                ip, minutes = parse_ip_line(line)
                add_ip(ip, minutes)
                added += 1
            except Exception:
                errors += 1

        context.user_data["state"] = STATE_NONE

        await update.message.reply_html(
            f"✅ Added <b>{added}</b> IPs.\n⚠️ Skipped <b>{errors}</b> lines.",
            reply_markup=main_menu(),
        )
        return

    if state == STATE_REMOVE_IP:
        try:
            ip = validate_ip(text)
            context.user_data["state"] = STATE_NONE

            if remove_ip(ip):
                await update.message.reply_html(
                    f"✅ Removed <code>{ip}</code>.",
                    reply_markup=main_menu(),
                )
            else:
                await update.message.reply_html(
                    f"⚠️ <code>{ip}</code> not found.",
                    reply_markup=main_menu(),
                )
        except Exception as e:
            await update.message.reply_html(f"❌ Error: <code>{e}</code>")
        return

    await update.message.reply_text("Use /start")


