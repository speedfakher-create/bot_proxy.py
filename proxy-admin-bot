async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data["state"] = STATE_NONE

    if is_admin(update):
        await update.message.reply_html(
            admin_dashboard(),
            reply_markup=main_menu(),
        )
        return

    await update.message.reply_html(
        user_welcome(),
        reply_markup=user_menu(),
    )


